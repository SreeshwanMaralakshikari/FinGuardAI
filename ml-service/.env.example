# FinGuardAI ML service — copy to .env for local runs (never commit .env).

# Shared secret; the backend sends it in the X-API-Key header. 32+ characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# The backend's ML_API_KEY must be exactly the same value.
ML_API_KEY=replace-with-64-hex-characters-from-the-command-above

# Optional
# MODEL_DIR=./model
# LOG_LEVEL=INFO

# Render only (Settings → Environment). Render's default for new services is
# Python 3.14; pin the version the service was tested with:
# PYTHON_VERSION=3.13.16
