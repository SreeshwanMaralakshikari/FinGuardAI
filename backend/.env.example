# ─────────────────────────────────────────────────────────────────────────────
# FinGuardAI Backend — environment variables
# Local dev: copy to .env (gitignored). Production: set these in Render →
# Service → Environment. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production   (Render: production).
# IMPORTANT: anything other than development/test is treated as production-like
# (Secure cookies, strict CORS, hidden error details), so set NODE_ENV=development locally.
NODE_ENV=development

# Render injects PORT automatically — do not set it on Render.
# 5000 is taken by AirPlay Receiver on macOS 12+; use 5001 there (and set VITE_DEV_BACKEND_URL).
PORT=5000

# MongoDB Atlas SRV connection string (database name included)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finguardai?retryWrites=true&w=majority

# ≥ 32 random characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Allowed browser origin(s) — comma-separated, https://, NO trailing slash.
#   dev:  http://localhost:3000
#   prod: https://finguardai.vercel.app
FRONTEND_URL=http://localhost:3000

# Cloudinary (profile image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run seed:admin` (run from your laptop, not on Render)
ADMIN_EMAIL=admin@finguardai.com
ADMIN_NAME=FinGuardAI Admin
ADMIN_PASSWORD=change-me-strong-password  # seed refuses this placeholder, and passwords < 12 chars, on production/remote DBs

# Optional: number of proxy hops in front of the app (Render = 1, default in production)
# TRUST_PROXY=1

# Business time zone for day boundaries / hour-of-day rules (default Asia/Kolkata)
# APP_TIME_ZONE=Asia/Kolkata

# Analyst self-registration. UNSET = analyst registration disabled (403).
# Set to a secret of >= 8 characters (use 16+); share it only with analysts.
# ANALYST_INVITE_CODE=

# Auth cookie mode: cross-site (default; frontend and API on different sites,
# SameSite=None; Secure; Partitioned) or same-site (SameSite=Lax; Secure).
# COOKIE_MODE=cross-site
# COOKIE_DOMAIN=            # optional, same-site mode only

# ── Operations (all optional) ────────────────────────────────────────────────
# Notifications are deleted by MongoDB after this many days (default 90; 0 = keep forever).
# NOTIFICATION_TTL_DAYS=90
# Audit-log entries are kept forever unless you set a number of days here.
# AUDIT_LOG_TTL_DAYS=
# A user with this many distinct devices stops creating new device-reputation records (default 20).
# MAX_DEVICES_PER_USER=20

# ── Phase 10: ML fraud scoring (optional) ────────────────────────────────────
# Off by default: the rule engine scores every payment. Set ML_ENABLED=true and the two values below
# to let the XGBoost model (ml-service/) score payments; the rule engine stays as the automatic fallback.
# ML_ENABLED=false
# Origin of the ML service — https, no path, no trailing slash. Local: http://localhost:5001
# ML_SERVICE_URL=https://finguardai-ml.onrender.com
# The SAME secret as ML_API_KEY on the ML service (32+ characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ML_API_KEY=
# How long a payment waits for the model before the rules decide (ms, 200–20000, default 2500).
# ML_TIMEOUT_MS=2500
# After a failure (e.g. the free Render instance is asleep) skip the model for this long while it wakes up
# (ms, 0–600000, default 60000).
# ML_COOLDOWN_MS=60000
