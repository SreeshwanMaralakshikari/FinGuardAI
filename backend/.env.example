# ─────────────────────────────────────────────────────────────────────────────
# FinGuardAI Backend — environment variables
# Local dev: copy to .env (gitignored). Production: set these in Render →
# Service → Environment. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# development | production   (Render: production)
NODE_ENV=development

# Render injects PORT automatically — do not set it on Render.
PORT=5000

# MongoDB Atlas SRV connection string (database name included)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finguardai?retryWrites=true&w=majority

# ≥ 32 random characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Allowed browser origin(s) — comma-separated, https://, NO trailing slash.
#   dev:  http://localhost:3000
#   prod: https://finguardai.vercel.app
FRONTEND_URL=http://localhost:3000

# Cloudinary (profile image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run seed:admin` (run from your laptop, not on Render)
ADMIN_EMAIL=admin@finguardai.com
ADMIN_NAME=FinGuardAI Admin
ADMIN_PASSWORD=change-me-strong-password  # seed refuses this placeholder, and passwords < 12 chars, on production/remote DBs

# Optional: number of proxy hops in front of the app (Render = 1, default in production)
# TRUST_PROXY=1

# Business time zone for day boundaries / hour-of-day rules (default Asia/Kolkata)
# APP_TIME_ZONE=Asia/Kolkata

# Analyst self-registration. UNSET = analyst registration disabled (403).
# Set to a secret of >= 8 characters (use 16+); share it only with analysts.
# ANALYST_INVITE_CODE=

# Auth cookie mode: cross-site (default; frontend and API on different sites,
# SameSite=None; Secure; Partitioned) or same-site (SameSite=Lax; Secure).
# COOKIE_MODE=cross-site
# COOKIE_DOMAIN=            # optional, same-site mode only
