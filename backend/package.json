{
  "name": "finguardai-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:admin": "node seed/seedAdmin.js",
    "db:sync-indexes": "node seed/syncIndexes.js",
    "db:backfill-payees": "node seed/backfillPayees.js",
    "db:backfill-payees:offline": "node --env-file=.env.offline seed/backfillPayees.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "seed:demo": "node scripts/seedDemoData.mjs",
    "offline:setup": "node scripts/offlineSetup.mjs",
    "offline:copy": "node scripts/copyAtlasToLocal.mjs",
    "start:offline": "node --env-file=.env.offline server.js",
    "seed:admin:offline": "node --env-file=.env.offline seed/seedAdmin.js",
    "seed:demo:offline": "node --env-file=.env.offline scripts/seedDemoData.mjs",
    "offline:accounts": "node --env-file=.env.offline scripts/offlineAccounts.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "description": "FinGuardAI backend: Express 5 + Mongoose 9 API with a real-time fraud-scoring engine",
  "license": "UNLICENSED",
  "overrides": {
    "test-exclude": "^8.0.0",
    "minimatch": "^11.0.3",
    "glob": "^14.0.3",
    "follow-redirects": "^1.16.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "mongodb-memory-server": false,
    "unrs-resolver": false
  }
}
