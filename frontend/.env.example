# ─────────────────────────────────────────────────────────────────────────────
# FinGuardAI Frontend — environment variables (Vite exposes only VITE_* keys)
# Template: copy to .env.local for local overrides (gitignored). This file is committed.
# Values are inlined into the JS bundle at BUILD time and are PUBLIC.
# Never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# PRODUCTION (set in Vercel → Settings → Environment Variables):
# Render API origin — a bare https origin: no path, no trailing slash, no spaces.
# REQUIRED for every `vite build` (the build fails without it); the value below is only an
# example, so it is commented out — copy the line and put your own URL there.
# VITE_API_URL=https://finguardai-api.onrender.com

# Optional: Socket.io origin if different from VITE_API_URL (normally leave unset;
# when set it must be a bare https origin too)
# VITE_SOCKET_URL=

# Optional: per-request timeout in ms (default 20000)
# VITE_API_TIMEOUT_MS=20000

# DEVELOPMENT ONLY: where the Vite proxy forwards /api and /socket.io
# (default http://localhost:5000). Not used in production builds.
# VITE_DEV_BACKEND_URL=http://localhost:5000

# ── Round 4 (all optional) ───────────────────────────────────────────────────
# One-click demo sign-in buttons on the login page (a demo customer and a demo analyst, never an admin).
# Only after `npm run seed:demo` has created the demo accounts on the SAME backend. Public: anyone who opens
# the site can use them, and the password ends up in the JavaScript bundle — demo accounts only.
# VITE_DEMO_LOGINS=true
# VITE_DEMO_PASSWORD=Demo@12345
# Absolute site address for link previews (og:image). On Vercel the production domain is used automatically.
# VITE_SITE_URL=https://your-app.vercel.app
